<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>FishbowlInventory</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Api\Integrations\" />
    <Folder Include="Api\LocationGroups\" />
    <Folder Include="Api\ManufactureOrders\" />
    <Folder Include="Api\Memos\" />
    <Folder Include="Api\Parts\" />
    <Folder Include="Api\PurchaseOrders\" />
    <Folder Include="Api\UnitsOfMeasure\" />
    <Folder Include="Api\Users\" />
    <Folder Include="Api\Vendors\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" /> <!-- ~~~~~ ThisAndThat Changed ~~~~~ updated latest - Version 11 in progress -->
    <PackageReference Include="System.Net.Http.Json" Version="10.0.12" /> <!-- ~~~~~ ThisAndThat Changed ~~~~~ updated latest Version 11 in progress -->
  </ItemGroup>

  <PropertyGroup>
    <PackageId>FishbowlInventory.RestApiTT</PackageId>
    <Title>FishbowlInventory.RestApiTT</Title>
    <Description>A C#/.net client library to interact with the Fishbowl Inventory REST API. The client does not fully implement all the API features (just yet) as it is following the needs of another project.</Description>
    <Version>1.0.1</Version> <!-- ~~~~~ 1.0.0 -> 1.0.1 -->
    <Authors>Josh Kirkpatrick with some edits by ThisandThat20</Authors><!-- ~~~~~ -->
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/ThisAndThat20/FishbowlInventory.RestApiTT</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ThisAndThat20/FishbowlInventory.RestApiTT</PackageProjectUrl>
    <PackageTags>Fishbowl, Inventory</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
